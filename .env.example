# Attendify Production Configuration

# Generate a strong secret key for production (e.g., using `python -c "import secrets; print(secrets.token_hex(32))"`)
FLASK_SECRET_KEY=your_generated_secret_key_here

# Set to 0 or false for production
FLASK_DEBUG=0

# Application Binding
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Database Configuration
DATABASE_PATH=database/attendance.db

# Path to YuNet and SFace model files
MODEL_DIRECTORY=models

# Upload limits (bytes) - default 10MB
MAX_CONTENT_LENGTH=10485760

# Secure session cookies (set to 0 for local non-HTTPS development, 1 for production behind HTTPS)
SESSION_COOKIE_SECURE=1
